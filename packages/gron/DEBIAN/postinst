#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="0.7.1"
BUILD_DIR="$TMPDIR/gron-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/tomnomnom/gron/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="1c98f2ef2ba03558864b1ab5e9c4b47a2e89d3ffaf24cfa0ac75cd38d775feb4"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o gron .
install -Dm755 gron "$PREFIX/bin/gron"

cd / && rm -rf "$BUILD_DIR"

echo "gron installed. Run 'gron'"
exit 0

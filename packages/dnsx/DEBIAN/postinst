#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="1.3.1"
BUILD_DIR="$TMPDIR/dnsx-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/projectdiscovery/dnsx/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="2c14a27b00e3215e1c0dc07afe9e5e5c3f0a3502852f1d5f497a92b5e6cb63db"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o dnsx ./cmd/dnsx
install -Dm755 dnsx "$PREFIX/bin/dnsx"

cd / && rm -rf "$BUILD_DIR"

echo "dnsx installed. Run 'dnsx'"
exit 0

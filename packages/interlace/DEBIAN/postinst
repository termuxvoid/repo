#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/codingo/Interlace.git"
DEST="$PREFIX/share/interlace"

pip install netaddr tqdm

rm -rf "$DEST" 2>/dev/null || true
git clone --depth 1 "$REPO" "$DEST"

python -m pip install --no-deps "$DEST"

echo "interlace installed. Run 'interlace'"
echo "Example: interlace -t 1.1.1.1 -threads 5 -c 'nmap -sV _target_'"
exit 0
#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="1.0.1"
BUILD_DIR="$TMPDIR/pwndrop-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/kgretzky/pwndrop/archive/refs/tags/1.0.1.tar.gz"
SHA256="ef8b74dd3819f020f5db9c6dd0db5e151369dac046a7435d471d48d0cc1d31a6"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -mod=vendor -trimpath -ldflags "-s -w" -o pwndrop main.go
install -Dm755 pwndrop "$PREFIX/bin/pwndrop"

cd / && rm -rf "$BUILD_DIR"

echo "pwndrop installed. Run 'pwndrop'"
exit 0

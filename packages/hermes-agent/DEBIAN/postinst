#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/NousResearch/hermes-agent"
VERSION="2026.7.20"
TAG="v${VERSION}"

INSTALL_DIR="$PREFIX/share/hermes-agent"

[ -d "$INSTALL_DIR" ] && rm -rf "$INSTALL_DIR"

# Download and extract release tarball
curl -Lf "https://codeload.github.com/NousResearch/hermes-agent/tar.gz/refs/tags/${TAG}" -o "$TMPDIR/hermes-agent.tar.gz" || {
    echo "Error: Failed to download hermes-agent." >&2
    exit 1
}

SHA256="285f3fc134ff466a90065e1517801a68993733b807158ee8f32aa01613786990"
if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/hermes-agent.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMPDIR/hermes-agent.tar.gz" >&2
    rm -f "$TMPDIR/hermes-agent.tar.gz"
    exit 1
fi
file "$TMPDIR/hermes-agent.tar.gz" | grep -q gzip || {
    echo "Error: Downloaded file is not gzip." >&2
    rm -f "$TMPDIR/hermes-agent.tar.gz"
    exit 1
}

mkdir -p "$INSTALL_DIR"
tar -xzf "$TMPDIR/hermes-agent.tar.gz" -C "$INSTALL_DIR" --strip-components=1
rm -f "$TMPDIR/hermes-agent.tar.gz"

cd "$INSTALL_DIR"

pip install --extra-index-url https://termux-user-repository.github.io/pypi/ --prefer-binary setuptools wheel

export ANDROID_API_LEVEL="$(getprop ro.build.version.sdk)"
python -m pip install --extra-index-url https://termux-user-repository.github.io/pypi/ --prefer-binary '.[termux]' -c constraints-termux.txt --ignore-requires-python 2>/dev/null || python -m pip install '.[termux]' --ignore-requires-python

echo "Hermes Agent installed successfully."
echo "Run 'hermes setup' to configure."
echo "Run 'hermes' to start."
exit 0

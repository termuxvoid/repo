#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/NousResearch/hermes-agent"
VERSION="0.23.1"
TAG="v${VERSION}"

INSTALL_DIR="$PREFIX/share/hermes-agent"

[ -d "$INSTALL_DIR" ] && rm -rf "$INSTALL_DIR"

# Download and extract release tarball
curl -Lf "https://codeload.github.com/NousResearch/hermes-agent/tar.gz/refs/tags/${TAG}" -o "$TMPDIR/hermes-agent.tar.gz" || {
    echo "Error: Failed to download hermes-agent." >&2
    exit 1
}

SHA256="52a8eb321f368576034f40595491abf9646b60c3861eee0cf45f610e5faa9bb6"
if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/hermes-agent.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMPDIR/hermes-agent.tar.gz" >&2
    rm -f "$TMPDIR/hermes-agent.tar.gz"
    exit 1
fi
file "$TMPDIR/hermes-agent.tar.gz" | grep -q gzip || {
    echo "Error: Downloaded file is not gzip." >&2
    rm -f "$TMPDIR/hermes-agent.tar.gz"
    exit 1
}

mkdir -p "$INSTALL_DIR"
tar -xzf "$TMPDIR/hermes-agent.tar.gz" -C "$INSTALL_DIR" --strip-components=1
rm -f "$TMPDIR/hermes-agent.tar.gz"

cd "$INSTALL_DIR"

# upstream blocks wheel builds; editable install is the supported source path
# android_24 matches the wheel tags of Termux's Python
export ANDROID_API_LEVEL=24
uv pip install --system --index-strategy unsafe-best-match \
    --extra-index-url https://termux-user-repository.github.io/pypi/ \
    'maturin>=1.9,<2' setuptools wheel

# upstream uv override: browser-harness pins Pillow 12, hermes needs 13
printf 'Pillow==13.0.0\n' > "$TMPDIR/hermes-overrides.txt"
uv pip install --system --no-build-isolation -e '.[termux]' \
    --overrides "$TMPDIR/hermes-overrides.txt" \
    --index-strategy unsafe-best-match \
    --extra-index-url https://termux-user-repository.github.io/pypi/
rm -f "$TMPDIR/hermes-overrides.txt"

echo "Hermes Agent installed successfully."
echo "Run 'hermes setup' to configure."
echo "Run 'hermes' to start."
exit 0

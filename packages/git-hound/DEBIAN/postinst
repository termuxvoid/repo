#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v3.2"
BUILD_DIR="$TMPDIR/git-hound-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/tillson/git-hound/archive/refs/tags/v3.2.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o git-hound .
install -Dm755 git-hound "$PREFIX/bin/git-hound"

cd / && rm -rf "$BUILD_DIR"

echo "git-hound installed. Run 'git-hound'"
exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/tillson/git-hound.git"
TAG="v3.2"
TMP_DIR="$TMPDIR/git-hound-build"
BIN="$PREFIX/bin/git-hound"

rm -rf "$TMP_DIR" 2>/dev/null || true
git clone -q --depth 1 --branch "$TAG" --config advice.detachedHead=false "$REPO" "$TMP_DIR"
cd "$TMP_DIR"
go build -trimpath -ldflags "-w -s" -o git-hound
install -Dm755 git-hound "$BIN"
cd /
rm -rf "$TMP_DIR"

[ -x "$BIN" ]
exit 0
#!/data/data/com.termux/files/usr/bin/bash

INSTALL_DIR="$PREFIX/share/qrylz"
LAUNCHER="$PREFIX/bin/qrylz"
JAR_URL="https://github.com/Anon4You/Qrylz/releases/download/v1.0.4/qrylz.jar"

echo "[*] Setting up Qrylz..."
mkdir -p "$INSTALL_DIR" && cd "$INSTALL_DIR" || exit 1

echo "[*] Downloading JAR..."
wget -q --show-progress "$JAR_URL" -O qrylz.jar || {
    echo -e "\n[!] Download failed. Possible fixes:"
    echo "    1. Check internet connection"
    echo "    2. Run: pkg install wget"
    echo "    3. Try manual download: $JAR_URL"
    exit 1
}

SHA256="18761d0a8d867cff9c9543fd4c949e92e5099e7d3342e5c73d492d16b68c4841"
if ! printf '%s  %s\n' "$SHA256" "qrylz.jar" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: qrylz.jar" >&2
    rm -f "qrylz.jar"
    exit 1
fi
echo "[*] Creating launcher..."
printf '%s\n' \
'#!/data/data/com.termux/files/usr/bin/bash' \
"exec java -jar \"$INSTALL_DIR/qrylz.jar\" \"\$@\"" > "$LAUNCHER"
chmod +x "$LAUNCHER" && echo -e "\n[+] Qrylz ready! Usage:\n  qrylz -h" || {
    echo "[!] Launcher creation failed"
    exit 1
}

#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v0.3.0"
BUILD_DIR="$TMPDIR/meg-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/tomnomnom/meg/archive/refs/tags/v0.3.0.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o meg ./
install -Dm755 meg "$PREFIX/bin/meg"

cd / && rm -rf "$BUILD_DIR"

echo "meg installed. Run 'meg'"
exit 0

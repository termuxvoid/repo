#!/data/data/com.termux/files/usr/bin/bash
set -e

mkdir -p $PREFIX/share/meg
cd $PREFIX/share/meg
if [ ! -d meg ]; then
    git clone --filter=blob:none --no-checkout https://github.com/tomnomnom/meg.git meg
fi
cd meg
git checkout -q 5cc1d344ce2c29f8c88f183dd70072a17f3d759a
go build -trimpath -ldflags "-w -s" -o $PREFIX/bin/meg ./

echo "meg installed successfully."
echo ""
echo "Usage examples:"
echo "  meg /robots.txt https://example.com"
echo "  meg -c 20 paths.txt hosts.txt"
echo "  cat hosts.txt | meg /admin"

exit 0
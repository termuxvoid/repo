#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="1.2.1"
BUILD_DIR="$TMPDIR/subzy-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/PentestPad/subzy/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="dc31f5affff111354694f1d936eced5425d4c4224f545107b29bb3ffca46b631"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o subzy .
install -Dm755 subzy "$PREFIX/bin/subzy"

cd / && rm -rf "$BUILD_DIR"

echo "subzy installed. Run 'subzy'"
exit 0

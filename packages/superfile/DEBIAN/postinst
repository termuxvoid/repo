#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v1.6.0"
BUILD_DIR="$TMPDIR/superfile-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/yorukot/superfile/archive/refs/tags/v1.6.0.tar.gz"
SHA256="7340ce9e3e7db401164310dd5d2d1dfa3ccf76118ac49d192b0fac2a292c5b0d"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o superfile .
install -Dm755 superfile "$PREFIX/bin/superfile"

cd / && rm -rf "$BUILD_DIR"

echo "superfile installed. Run 'superfile'"
exit 0

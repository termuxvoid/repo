#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v1.6.0"
BUILD_DIR="$TMPDIR/superfile-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/yorukot/superfile/archive/refs/tags/v1.6.0.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o superfile .
install -Dm755 superfile "$PREFIX/bin/superfile"

cd / && rm -rf "$BUILD_DIR"

echo "superfile installed. Run 'superfile'"
exit 0

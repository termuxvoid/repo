#!/data/data/com.termux/files/usr/bin/bash
set -e

echo "[*] Checking device architecture..."
ARCH=$(uname -m)

case "$ARCH" in
    aarch64|x86_64)
        echo "[√] Architecture check passed: $ARCH"
        exit 0
        ;;
    *)
        echo "[!] ERROR: This package supports aarch64 and x86_64 only"
        echo "[!] Your device architecture: $ARCH"
        echo "[!] Installation cannot continue"
        exit 1
        ;;
esac

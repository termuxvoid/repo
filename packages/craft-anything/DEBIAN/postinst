#!/data/data/com.termux/files/usr/bin/bash
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
VERSION="0.6.1"
ARCH=$(uname -m)

case "$ARCH" in
    aarch64)
        SHA256="b4255ac806e2a598b9fc6dba4e8ed2190e49baafd2f68dd7e037f3294e472941"
        ASSET="craft-anything-${VERSION}-linux-aarch64.tar.gz"
        DIR="craft-anything-${VERSION}-linux-aarch64"
        LD_SO="ld-linux-aarch64.so.1"
        ;;
    x86_64)
        SHA256="83ec0730c9117f399122b315c63ed4c3a8d31ac55bddd74cb8b33cd2f76ef704"
        ASSET="craft-anything-${VERSION}-linux-x86_64.tar.gz"
        DIR="craft-anything-${VERSION}-linux-x86_64"
        LD_SO="ld-linux-x86-64.so.2"
        ;;
    *)
        echo "Unsupported architecture: $ARCH" >&2
        exit 1
        ;;
esac

URL="https://github.com/storytold/craft-anything/releases/download/v${VERSION}/${ASSET}"
SHARE_DIR="$PREFIX/share/craft-anything"
BIN_DIR="$PREFIX/bin"
LOADER="$PREFIX/glibc/lib/${LD_SO}"
LIB_PATH="$PREFIX/glibc/lib"
REAL_BIN="$SHARE_DIR/craft-anything-cli.real"
TMP_DIR="${TMPDIR:-$PREFIX/tmp}/craft-anything-build"

mkdir -p "$PREFIX/glibc/etc"
ln -sf "$PREFIX/etc/resolv.conf" "$PREFIX/glibc/etc/resolv.conf"
ln -sf "$PREFIX/etc/hosts" "$PREFIX/glibc/etc/hosts"

rm -rf "$SHARE_DIR" "$TMP_DIR"
mkdir -p "$SHARE_DIR" "$BIN_DIR" "$TMP_DIR"

echo "Downloading Craft Anything ${VERSION} for ${ARCH}..."
curl -fL --progress-bar -o "$TMP_DIR/$ASSET" "$URL"
if ! printf '%s  %s\n' "$SHA256" "$TMP_DIR/$ASSET" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $ASSET" >&2
    rm -rf "$TMP_DIR"
    exit 1
fi

tar -xzf "$TMP_DIR/$ASSET" -C "$TMP_DIR" "$DIR/bin/craft-anything-cli"
install -Dm755 "$TMP_DIR/$DIR/bin/craft-anything-cli" "$REAL_BIN"

cat > "$BIN_DIR/craft-anything-cli" << EOF
#!/data/data/com.termux/files/usr/bin/bash
unset LD_PRELOAD LD_LIBRARY_PATH
export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
exec "$LOADER" --library-path "$LIB_PATH" "$REAL_BIN" "\$@"
EOF
chmod +x "$BIN_DIR/craft-anything-cli"

rm -rf "$TMP_DIR"

echo "[✓] craft-anything-cli installed. Run: craft-anything-cli --help"
echo "    This package uses Termux's glibc environment; the desktop GUI is not included."
exit 0

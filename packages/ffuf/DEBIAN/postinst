#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v2.3.0"
BUILD_DIR="$TMPDIR/ffuf-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/ffuf/ffuf/archive/refs/tags/v2.3.0.tar.gz"
SHA256="cdb2e58259f380862850eba587f71a9dc1738fb5edc1ea60414fae30fd0ed4f2"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o ffuf .
install -Dm755 ffuf "$PREFIX/bin/ffuf"

cd / && rm -rf "$BUILD_DIR"

echo "ffuf installed. Run 'ffuf'"
exit 0

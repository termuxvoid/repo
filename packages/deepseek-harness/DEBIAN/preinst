#!/data/data/com.termux/files/usr/bin/bash
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}

if [ "$(uname -m)" != "aarch64" ]; then
    echo "Error: deepseek-harness is only available for aarch64 (ARM64)." >&2
    echo "Your architecture: $(uname -m)" >&2
    exit 1
fi

if [ ! -x "$PREFIX/glibc/lib/ld-linux-aarch64.so.1" ]; then
    echo "Error: glibc loader not found." >&2
    echo "Install the glibc repository first: pkg install glibc-repo glibc" >&2
    exit 1
fi

exit 0

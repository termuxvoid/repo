#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="2.17.0"
BUILD_DIR="$TMPDIR/subfinder-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/projectdiscovery/subfinder/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="f9fffdfac6b9668eb8497e661a6ccd24cf83a0f459a41902ad0a782e63b39a2b"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o subfinder ./cmd/subfinder
install -Dm755 subfinder "$PREFIX/bin/subfinder"

cd / && rm -rf "$BUILD_DIR"

echo "subfinder installed. Run 'subfinder'"
exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
SDK_DIR="$PREFIX/opt/android-sdk"
ARCH=$(uname -m)

case "$ARCH" in
    aarch64)
        ASSET_ARCH="aarch64"
        SHA256="4d1eaa28e54c845d501d0dda686392219f10db2a3d9ef7c9060e9f6d356d4646"
        ;;
    x86_64)
        ASSET_ARCH="x86_64"
        SHA256="a3cfeffb07b55bcba2466cbe0834d6f9424ef7579097a275b56259458e79b506"
        ;;
    *)
        echo "[!] Unsupported architecture: $ARCH" >&2
        exit 1
        ;;
esac

DOWNLOAD_URL="https://github.com/HomuHomu833/android-sdk-custom/releases/download/37.0.0/android-sdk-${ASSET_ARCH}-linux-android.tar.xz"
TMP_ARCHIVE="$TMPDIR/android-sdk.tar.xz"

echo "[*] Downloading Android SDK 37.0.0..."
mkdir -p "$PREFIX/opt"
rm -rf "$SDK_DIR"
mkdir -p "$SDK_DIR"
axel -n 4 -o "$TMP_ARCHIVE" "$DOWNLOAD_URL" || { echo "[!] Download failed" >&2; exit 1; }

if ! printf '%s  %s\n' "$SHA256" "$TMP_ARCHIVE" | sha256sum -c - >/dev/null; then
    echo "[!] Checksum mismatch: $TMP_ARCHIVE" >&2
    rm -f "$TMP_ARCHIVE"
    exit 1
fi

echo "[*] Extracting Android SDK..."
tar -xJf "$TMP_ARCHIVE" -C "$SDK_DIR" --strip-components=1
rm -f "$TMP_ARCHIVE"

# sdkmanager only accepts the <sdk>/cmdline-tools/latest layout
if [ -d "$SDK_DIR/cmdline-tools/bin" ]; then
    mkdir -p "$SDK_DIR/cmdline-tools/latest"
    for f in "$SDK_DIR"/cmdline-tools/*; do
        [ "$(basename "$f")" = latest ] || mv "$f" "$SDK_DIR/cmdline-tools/latest/"
    done
fi

# Termux has no /usr/bin/env
termux-fix-shebang "$SDK_DIR"/cmdline-tools/latest/bin/*

ln -sf "$SDK_DIR/cmdline-tools/latest/bin/sdkmanager" "$PREFIX/bin/sdkmanager"

[ -x "$SDK_DIR/platform-tools/adb" ] || { echo "[!] adb not found" >&2; exit 1; }
[ -x "$SDK_DIR/cmdline-tools/latest/bin/sdkmanager" ] || { echo "[!] sdkmanager not found" >&2; exit 1; }
[ -x "$PREFIX/bin/sdkmanager" ] || { echo "[!] sdkmanager not linked" >&2; exit 1; }
echo "[√] Android SDK installed at $SDK_DIR"
echo "    Install what you need, e.g.: sdkmanager \"platforms;android-36\""
echo "    Flutter: flutter config --android-sdk \"$SDK_DIR\""

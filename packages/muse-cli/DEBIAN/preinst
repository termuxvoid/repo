#!/data/data/com.termux/files/usr/bin/bash
set -e

ARCH=$(uname -m)
case "$ARCH" in
    aarch64|arm64) ;;
    *)
        echo "muse-cli currently supports aarch64 only." >&2
        echo "The native sysfix shim has not been tested on $ARCH; proot support was removed." >&2
        exit 1
        ;;
esac

exit 0

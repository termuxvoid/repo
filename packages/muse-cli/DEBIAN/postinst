#!/data/data/com.termux/files/usr/bin/bash
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
VERSION="1.4.15-R8339.1"
ARCH=$(uname -m)

case "$ARCH" in
    aarch64|arm64)
        SHA256="d0760247116f75f3cbd15e85f978b0e010d4846161d110df871bcaf346bbf60e"
        ASSET="muse-aarch64-linux"
        ;;
    *)
        echo "Unsupported architecture: $ARCH (aarch64 only)" >&2
        exit 1
        ;;
esac

URL="https://lookaside.facebook.com/lookaside/muse/download/?channel=muse&version=${VERSION}&file=${ASSET}"
BIN="$PREFIX/libexec/muse/muse"
PART="$PREFIX/libexec/muse/.muse.part"
OLD="$PREFIX/bin/muse"
SYSFIX="$PREFIX/libexec/muse/sysfix"
SYSFIX_PART="$PREFIX/libexec/muse/.sysfix.part"
SYSFIX_URL="https://raw.githubusercontent.com/termuxvoid/repo/main/packages/muse-cli/sysfix-aarch64"
SYSFIX_SHA256="3bb8814bfb7420a34dd04b7095ab119f0f1d7926df74339c347ad2289d8c38e1"

mkdir -p "$PREFIX/bin" "$PREFIX/libexec/muse"
trap 'rm -f "$PART" "$SYSFIX_PART"' EXIT

if [ -x "$BIN" ] && printf '%s  %s\n' "$SHA256" "$BIN" | sha256sum -c - >/dev/null 2>&1; then
    echo "Muse Code binary is already installed."
elif [ -x "$OLD" ] && printf '%s  %s\n' "$SHA256" "$OLD" | sha256sum -c - >/dev/null 2>&1; then
    echo "Reusing existing Muse Code binary..."
    mv -f "$OLD" "$BIN"
else
    echo "Downloading Muse Code ${VERSION} for ${ARCH} (~400 MB)..."
    curl -fL --retry 3 --progress-bar -o "$PART" "$URL"
    if ! printf '%s  %s\n' "$SHA256" "$PART" | sha256sum -c - >/dev/null; then
        echo "checksum mismatch: $PART" >&2
        exit 1
    fi
    chmod +x "$PART"
    mv -f "$PART" "$BIN"
fi
chmod 755 "$BIN"

if [ -x "$SYSFIX" ] && printf '%s  %s\n' "$SYSFIX_SHA256" "$SYSFIX" | sha256sum -c - >/dev/null 2>&1; then
    echo "Native sysfix is already installed."
else
    echo "Downloading native sysfix..."
    curl -fL --retry 3 -o "$SYSFIX_PART" "$SYSFIX_URL"
    if ! printf '%s  %s\n' "$SYSFIX_SHA256" "$SYSFIX_PART" | sha256sum -c - >/dev/null; then
        echo "sysfix checksum mismatch: $SYSFIX_PART" >&2
        exit 1
    fi
    chmod 755 "$SYSFIX_PART"
    mv -f "$SYSFIX_PART" "$SYSFIX"
fi
trap - EXIT

rm -rf "$PREFIX/share/muse/root"
rmdir "$PREFIX/share/muse" 2>/dev/null || true

cat > "$PREFIX/bin/muse" <<'WRAPPER'
#!/data/data/com.termux/files/usr/bin/bash
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
BIN="$PREFIX/libexec/muse/muse"
SYSFIX="$PREFIX/libexec/muse/sysfix"

if [ ! -x "$BIN" ]; then
    echo "muse: binary not found: $BIN" >&2
    exit 1
fi
if [ ! -x "$SYSFIX" ]; then
    echo "muse: native sysfix is missing; reinstall muse-cli" >&2
    exit 1
fi

# Android has no working bwrap; keep shell tools usable.
has_sandbox=
for arg in "$@"; do
    case "$arg" in
        --disable-sandbox|--disable-sandbox=*|--yolo) has_sandbox=1 ;;
    esac
done
if [ -z "$has_sandbox" ]; then
    case "${1:-}" in
        exec) set -- exec --disable-sandbox "${@:2}" ;;
        resume|config|export|trace|model-profile|skills|voice|plugins|sandbox|schema|serve|mxp|attach|session-message|sessions|mcp|auth|login|logout|usage|init|help)
            ;;
        -h|--help|-V|--version)
            ;;
        *) set -- --disable-sandbox "$@" ;;
    esac
fi

unset LD_PRELOAD
: "${MUSE_NO_AUTO_UPDATE:=1}"
export MUSE_NO_AUTO_UPDATE

exec "$SYSFIX" "$BIN" "$@"
WRAPPER
chmod 755 "$PREFIX/bin/muse"

echo "Muse Code $VERSION installed successfully."
echo "Run 'muse login' once, then 'muse'."
echo "Native aarch64 mode; proot is not required."
exit 0

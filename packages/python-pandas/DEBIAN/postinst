#!/data/data/com.termux/files/usr/bin/bash
set -e

# TUR community wheel index: prebuilt Android pandas wheel,
# no on-device source build needed.
pip install --extra-index-url https://termux-user-repository.github.io/pypi/ pandas==3.0.5 || {
    echo "Error: Failed to install pandas." >&2
    exit 1
}

echo "Pandas installed successfully!"
echo "    Test with: python3 -c 'import pandas; print(pandas.__version__)'"
exit 0

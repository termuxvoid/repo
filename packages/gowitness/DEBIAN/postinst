#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="3.2.2"
BUILD_DIR="$TMPDIR/gowitness-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/sensepost/gowitness/archive/refs/tags/3.2.2.tar.gz"
SHA256="8c63b547bcafcae2b93246a598fb06124d8794cb8d5d3719c5cfc791a78ad3d2"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o gowitness .
install -Dm755 gowitness "$PREFIX/bin/gowitness"

cd / && rm -rf "$BUILD_DIR"

echo "gowitness installed. Run 'gowitness'"
exit 0

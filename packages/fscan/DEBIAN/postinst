#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v2.2.2"
BUILD_DIR="$TMPDIR/fscan-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/shadow1ng/fscan/archive/refs/tags/v2.2.2.tar.gz"
SHA256="4ad616dc215ceb683113ec6d3b96480d13e3321495e0f9657c1bb42aa6d62556"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o fscan .
install -Dm755 fscan "$PREFIX/bin/fscan"

cd / && rm -rf "$BUILD_DIR"

echo "fscan installed. Run 'fscan'"
exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v8.30.1"
BUILD_DIR="$TMPDIR/gitleaks-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/gitleaks/gitleaks/archive/refs/tags/v8.30.1.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o gitleaks .
install -Dm755 gitleaks "$PREFIX/bin/gitleaks"

cd / && rm -rf "$BUILD_DIR"

echo "gitleaks installed. Run 'gitleaks'"
exit 0

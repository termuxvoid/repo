#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v8.30.1"
BUILD_DIR="$TMPDIR/gitleaks-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/gitleaks/gitleaks/archive/refs/tags/v8.30.1.tar.gz"
SHA256="e90fb266d75837e75894c778bf594ab8e2787f12dce5a62651f21b893eaf9abb"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o gitleaks .
install -Dm755 gitleaks "$PREFIX/bin/gitleaks"

cd / && rm -rf "$BUILD_DIR"

echo "gitleaks installed. Run 'gitleaks'"
exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -e

BASE="https://github.com/peass-ng/PEASS-ng/releases/download/20261029-a596a9f3"

rm -rf "$TMPDIR/peass-download"
mkdir -p "$TMPDIR/peass-download" $PREFIX/share/peass/linPEAS $PREFIX/share/peass/winPEAS

curl -fsSL -o "$TMPDIR/peass-download/linpeas.sh" \
    "$BASE/linpeas.sh"
SHA256="685b6a2ebbf1e5185a28f3ae23b6fcfa9ad9270a47b46fb8ad6947f0a0d87a5a"
if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/peass-download/linpeas.sh" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMPDIR/peass-download/linpeas.sh" >&2
    rm -f "$TMPDIR/peass-download/linpeas.sh"
    exit 1
fi
curl -fsSL -o "$TMPDIR/peass-download/linpeas_fat.sh" \
    "$BASE/linpeas_fat.sh"
SHA256="2cc351be7a24732d6b83a3a6b179af30129a285b1d4254c3f122bc4dd62eb5e1"
if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/peass-download/linpeas_fat.sh" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMPDIR/peass-download/linpeas_fat.sh" >&2
    rm -f "$TMPDIR/peass-download/linpeas_fat.sh"
    exit 1
fi
curl -fsSL -o "$TMPDIR/peass-download/winPEAS.bat" \
    "$BASE/winPEAS.bat"
SHA256="cd45a0db52a7a887e34622c0af501cfcd67b65267517fe9964bd2d5af2e9d1a2"
if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/peass-download/winPEAS.bat" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMPDIR/peass-download/winPEAS.bat" >&2
    rm -f "$TMPDIR/peass-download/winPEAS.bat"
    exit 1
fi
mv "$TMPDIR/peass-download/linpeas.sh" $PREFIX/share/peass/linPEAS/linpeas.sh
mv "$TMPDIR/peass-download/linpeas_fat.sh" $PREFIX/share/peass/linPEAS/linpeas_fat.sh
mv "$TMPDIR/peass-download/winPEAS.bat" $PREFIX/share/peass/winPEAS/winPEAS.bat
rm -rf "$TMPDIR/peass-download"

chmod 0755 $PREFIX/share/peass/linPEAS/linpeas.sh \
    $PREFIX/share/peass/linPEAS/linpeas_fat.sh

ln -sf $PREFIX/share/peass/linPEAS/linpeas.sh $PREFIX/bin/linpeas
ln -sf $PREFIX/share/peass/linPEAS/linpeas_fat.sh $PREFIX/bin/linpeas_fat

echo "peass installed successfully."
echo ""
echo "Usage examples:"
echo "  linpeas                       (full system enumeration)"
echo "  linpeas -a                    (all system checks, slow)"
echo "  linpeas_fat                   (enumerates checks requiring more tools)"
echo "  winPEAS.bat is saved in \$PREFIX/share/peass/winPEAS/"

exit 0
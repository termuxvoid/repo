#!/data/data/com.termux/files/usr/bin/bash
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}

ARCH=$(uname -m)
case "$ARCH" in
    aarch64)
        LD_SO="ld-linux-aarch64.so.1"
        ;;
    x86_64)
        LD_SO="ld-linux-x86-64.so.2"
        ;;
    *)
        echo "Error: glibc-nodejs supports only aarch64 and x86_64." >&2
        echo "Your architecture: $ARCH" >&2
        exit 1
        ;;
esac

if [ ! -x "$PREFIX/glibc/lib/$LD_SO" ]; then
    echo "Error: glibc loader not found." >&2
    echo "Install the glibc repository first: pkg install glibc-repo glibc" >&2
    exit 1
fi

exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="0.1.29"
URL="https://github.com/mesamirh/MovieBox-Tui/archive/refs/tags/v${VERSION}.tar.gz"
TMP_DIR="$TMPDIR/moviebox-tui-build"
BIN_DIR="$PREFIX/bin"

rm -rf "$TMP_DIR" 2>/dev/null || true
mkdir -p "$TMP_DIR"
cd "$TMP_DIR"

curl -fsSL -o source.tar.gz "$URL"
SHA256="391cd06f662558ec5f5c28f50e911af29df068bd93e89d5a30a9f4b3c198f86d"
if ! printf '%s  %s\n' "$SHA256" "source.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: source.tar.gz" >&2
    rm -f "source.tar.gz"
    exit 1
fi
tar -xzf source.tar.gz --strip-components=1

RUSTFLAGS="-C opt-level=z" cargo build --release -j$(nproc --all)

install -Dm755 target/release/moviebox-tui "$BIN_DIR/moviebox-tui"

cd / && rm -rf "$TMP_DIR"

echo "moviebox-tui installed. Run 'moviebox-tui'"
exit 0

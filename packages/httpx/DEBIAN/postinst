#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="1.12.0"
BUILD_DIR="$TMPDIR/httpx-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/projectdiscovery/httpx/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="b29319c085537047bff8acf72c6cd4ecf17585ede97f4afdde2304431c74e64e"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o httpx ./cmd/httpx
install -Dm755 httpx "$PREFIX/bin/httpx"

cd / && rm -rf "$BUILD_DIR"

echo "httpx installed. Run 'httpx'"
exit 0

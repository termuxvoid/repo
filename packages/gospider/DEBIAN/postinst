#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v1.1.6"
BUILD_DIR="$TMPDIR/gospider-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/jaeles-project/gospider/archive/refs/tags/v1.1.6.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o gospider ./
install -Dm755 gospider "$PREFIX/bin/gospider"

cd / && rm -rf "$BUILD_DIR"

echo "gospider installed. Run 'gospider'"
exit 0

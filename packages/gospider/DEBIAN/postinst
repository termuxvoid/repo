#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v1.1.6"
BUILD_DIR="$TMPDIR/gospider-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/jaeles-project/gospider/archive/refs/tags/v1.1.6.tar.gz"
SHA256="7cea9840c8a81c4b6be2c5984b25398a13bfe83cfd613332e8092f4c69d6ab5f"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o gospider ./
install -Dm755 gospider "$PREFIX/bin/gospider"

cd / && rm -rf "$BUILD_DIR"

echo "gospider installed. Run 'gospider'"
exit 0

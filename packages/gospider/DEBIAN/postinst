#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/jaeles-project/gospider/archive/refs/tags/v1.1.6.tar.gz"
TMP_DIR="$TMPDIR/gospider-build"
BIN_DIR="$PREFIX/bin"

rm -rf "$TMP_DIR" 2>/dev/null || true
mkdir -p "$TMP_DIR"

curl -fsSL -o "$TMP_DIR/gospider.tar.gz" "$REPO"
tar xzf "$TMP_DIR/gospider.tar.gz" -C "$TMP_DIR"
cd "$TMP_DIR/gospider-1.1.6"

go build -trimpath -ldflags "-w -s" -o gospider ./

install -Dm755 gospider "$BIN_DIR/gospider"

cd / && rm -rf "$TMP_DIR"

echo "gospider installed. Run 'gospider'"
echo "Example: gospider --sitemap -q https://example.com"
exit 0
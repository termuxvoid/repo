#!/data/data/com.termux/files/usr/bin/bash
set -e

BUILD_DIR="$TMPDIR/hulk-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/grafov/hulk/archive/refs/heads/master.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o hulk .
install -Dm755 hulk "$PREFIX/bin/hulk"

cd / && rm -rf "$BUILD_DIR"

echo "hulk installed. Run 'hulk'"
exit 0

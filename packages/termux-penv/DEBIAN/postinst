#!/data/data/com.termux/files/usr/bin/bash
set -e

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
VERSION="3.0.0"
URL="https://github.com/Anon4You/termux-penv/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="0d38aead0cb39d4821e3127b9808b71ed0b9b54a4be8e76c1624ae450c8ff670"
BUILD_DIR="${TMPDIR:-$PREFIX/tmp}/termux-penv-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "$URL"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

install -Dm755 bin/termux-penv "$PREFIX/bin/termux-penv"
ln -sf termux-penv "$PREFIX/bin/tp"

rm -rf "$PREFIX/share/termux-penv"
install -d "$PREFIX/share/termux-penv"
install -m755 scripts/*.sh "$PREFIX/share/termux-penv/"

cd / && rm -rf "$BUILD_DIR"

echo "termux-penv ${VERSION} installed."
echo "Run 'termux-penv help' for usage."
exit 0

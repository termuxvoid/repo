#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="0.25.1"
BUILD_DIR="$TMPDIR/wacli-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/steipete/wacli/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="23d65dcd6d66f30dbb1e8a94c6a0e22fa0ae266a6bbd8ba5d2a619a6ff734191"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -tags sqlite_fts5 -o ./dist/wacli ./cmd/wacli
install -Dm755 ./dist/wacli "$PREFIX/bin/wacli"

cd / && rm -rf "$BUILD_DIR"

echo "wacli installed. Run 'wacli'"
exit 0

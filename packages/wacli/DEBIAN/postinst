#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="0.22.0"
BUILD_DIR="$TMPDIR/wacli-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/steipete/wacli/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -tags sqlite_fts5 -o ./dist/wacli ./cmd/wacli
install -Dm755 ./dist/wacli "$PREFIX/bin/wacli"

cd / && rm -rf "$BUILD_DIR"

echo "wacli installed. Run 'wacli'"
exit 0

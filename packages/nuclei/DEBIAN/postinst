#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="3.11.1"
BUILD_DIR="$TMPDIR/nuclei-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/projectdiscovery/nuclei/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="64c6e21eb8cd141d39cbb0241228fb40fd4370dbe39dc9f13e1069c718b711f9"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o nuclei ./cmd/nuclei
install -Dm755 nuclei "$PREFIX/bin/nuclei"

cd / && rm -rf "$BUILD_DIR"

echo "nuclei installed. Run 'nuclei'"
exit 0

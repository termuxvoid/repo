#!/data/data/com.termux/files/usr/bin/bash
set -e
 
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
VERSION="1.19.4"
ARCH=$(uname -m)
case "$ARCH" in
    aarch64)
        SHA256="8568230ccd847dc93e95b9f6894379077d3e014a16b48040743573e77c23e85f"
        TARFILE="opencode-linux-arm64.tar.gz"
        LD_SO="ld-linux-aarch64.so.1"
        ;;
    x86_64)
        SHA256="849bd6b3d959a1d2ef200ed1634a51c79a45ca236aa26665d75debd694805cce"
        TARFILE="opencode-linux-x64.tar.gz"
        LD_SO="ld-linux-x86-64.so.2"
        ;;
    *)
        echo "Unsupported architecture: $ARCH" >&2
        exit 1
        ;;
esac
DOWNLOAD_URL="https://github.com/anomalyco/opencode/releases/download/v${VERSION}/${TARFILE}"

SHARE_DIR="$PREFIX/share/opencode"
BIN_DIR="$PREFIX/bin"
LOADER="$PREFIX/glibc/lib/$LD_SO"
REAL_BIN="$SHARE_DIR/opencode.real"
LIB_PATH="$PREFIX/glibc/lib"

# Create directories
mkdir -p "$SHARE_DIR" "$BIN_DIR"

# Download and extract
echo "Downloading opencode ${VERSION}..."
curl -fsSL -o "$TMPDIR/opencode.tar.gz" "$DOWNLOAD_URL"
if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/opencode.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMPDIR/opencode.tar.gz" >&2
    rm -f "$TMPDIR/opencode.tar.gz"
    exit 1
fi
tar -xzf "$TMPDIR/opencode.tar.gz" -C "$SHARE_DIR"
rm -f "$TMPDIR/opencode.tar.gz"
if [ ! -f "$SHARE_DIR/opencode" ]; then
    echo "Error: opencode binary not found after extraction." >&2
    exit 1
fi
mv "$SHARE_DIR/opencode" "$REAL_BIN"
chmod +x "$REAL_BIN"

# Write wrapper source
cat > "$TMPDIR/opencode_helper.c" << EOF
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <libgen.h>
#include <limits.h>
#include <stdio.h>

int main(int argc, char** argv) {
    unsetenv("LD_PRELOAD");
    unsetenv("LD_LIBRARY_PATH");

    setenv("GODEBUG", "netdns=cgo", 1);
    setenv("SSL_CERT_FILE", "/data/data/com.termux/files/usr/etc/tls/cert.pem", 1);

    char* loader = "$LOADER";
    char real_bin[] = "/data/data/com.termux/files/usr/share/opencode/opencode.real";
    char lib_path[] = "$LIB_PATH";

    char** new_argv = malloc((argc + 4) * sizeof(char*));
    if (!new_argv) {
        return 1;
    }

    new_argv[0] = loader;
    new_argv[1] = "--library-path";
    new_argv[2] = lib_path;
    new_argv[3] = real_bin;

    for (int i = 1; i < argc; i++) {
        new_argv[i + 3] = argv[i];
    }
    new_argv[argc + 3] = NULL;

    execv(loader, new_argv);
    perror("execv");
    free(new_argv);
    return 1;
}
EOF

# Compile wrapper
clang -O2 -o "$BIN_DIR/opencode" "$TMPDIR/opencode_helper.c"
chmod +x "$BIN_DIR/opencode"

# Clean up temporary source
rm -f "$TMPDIR/opencode_helper.c"

echo "OpenCode $VERSION installed successfully."
echo "Run 'opencode' to start."
exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -e
 
PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
VERSION="1.18.4"
TARFILE="opencode-linux-arm64.tar.gz"
DOWNLOAD_URL="https://github.com/anomalyco/opencode/releases/download/v${VERSION}/${TARFILE}"

SHARE_DIR="$PREFIX/share/opencode"
BIN_DIR="$PREFIX/bin"
LOADER="$PREFIX/glibc/lib/ld-linux-aarch64.so.1"
REAL_BIN="$SHARE_DIR/opencode.real"
LIB_PATH="$PREFIX/glibc/lib"

# Create directories
mkdir -p "$SHARE_DIR" "$BIN_DIR"

# Download and extract
echo "Downloading opencode ${VERSION}..."
curl -fsSL "$DOWNLOAD_URL" | tar -xz -C "$SHARE_DIR"
if [ ! -f "$SHARE_DIR/opencode" ]; then
    echo "Error: opencode binary not found after extraction." >&2
    exit 1
fi
mv "$SHARE_DIR/opencode" "$REAL_BIN"
chmod +x "$REAL_BIN"

# Write C++ wrapper source
cat > "$TMPDIR/opencode_wrapper.cpp" << 'EOF'
#include <unistd.h>
#include <cstdlib>

constexpr const char* REAL_BIN = "/data/data/com.termux/files/usr/share/opencode/opencode.real";
constexpr const char* GLIBC_LIB = "/data/data/com.termux/files/usr/glibc/lib";
constexpr const char* GLIBC_LD = "/data/data/com.termux/files/usr/glibc/lib/ld-linux-aarch64.so.1";
constexpr const char* CERT_FILE = "/data/data/com.termux/files/usr/etc/tls/cert.pem";

int main(int argc, char* argv[]) {
    setenv("LD_LIBRARY_PATH", GLIBC_LIB, 1);
    setenv("GODEBUG", "netdns=cgo", 1);
    setenv("SSL_CERT_FILE", CERT_FILE, 1);

    const char* new_argv[argc + 4];
    new_argv[0] = GLIBC_LD;
    new_argv[1] = "--library-path";
    new_argv[2] = GLIBC_LIB;
    new_argv[3] = REAL_BIN;
    for (int i = 1; i < argc; ++i) {
        new_argv[i + 3] = argv[i];
    }
    new_argv[argc + 3] = nullptr;

    execv(GLIBC_LD, const_cast<char* const*>(new_argv));
    perror("execv failed");
    return 1;
}
EOF

# Compile C++ wrapper
clang++ -O2 -o "$BIN_DIR/opencode" "$TMPDIR/opencode_wrapper.cpp"
chmod +x "$BIN_DIR/opencode"

# Clean up temporary source
rm -f "$TMPDIR/opencode_wrapper.cpp"

echo "OpenCode $VERSION installed successfully."
echo "Run 'opencode' to start."
exit 0
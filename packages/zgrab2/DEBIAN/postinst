#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v1.0.0"
BUILD_DIR="$TMPDIR/zgrab2-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/zmap/zgrab2/archive/refs/tags/v1.0.0.tar.gz"
SHA256="682e9c12ecd8714d8702c88f37916c43654ec1091e97d7d0cc76e54236fcd6cc"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

export CGO_ENABLED=0
go build -trimpath -ldflags "-w -s" -o zgrab2 ./cmd/zgrab2
install -Dm755 zgrab2 "$PREFIX/bin/zgrab2"

mkdir -p "$HOME/.config/zgrab2"
touch "$HOME/.config/zgrab2/blocklist.conf"

cd / && rm -rf "$BUILD_DIR"

echo "zgrab2 installed. Run 'zgrab2'"
exit 0

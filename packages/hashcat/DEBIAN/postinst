#!/data/data/com.termux/files/usr/bin/bash
set -e

HASHCAT_DIR="$PREFIX/opt/hashcat"
BUILD="$TMPDIR/hashcat-build"
VERSION="8.0.0"
ARCHIVE="hashcat-${VERSION}.tar.gz"
URL="https://github.com/hashcat/hashcat/archive/refs/tags/v${VERSION}.tar.gz"

print_status() { echo -e "[*] $1"; }
print_error() { echo -e "[!] Error: $1"; exit 1; }

# --- Download & extract source ---
rm -rf "$BUILD"
mkdir -p "$BUILD"

print_status "Downloading hashcat ${VERSION} source..."
curl -sL -o "$TMPDIR/$ARCHIVE" "$URL" || print_error "Download failed"

SHA256="6281721ef2bc57aed1ffa1a186aa39d01cee09899741cb58e027733a373c2ae3"
if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/$ARCHIVE" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: $TMPDIR/$ARCHIVE" >&2
    rm -f "$TMPDIR/$ARCHIVE"
    exit 1
fi
tar xzf "$TMPDIR/$ARCHIVE" -C "$BUILD" --strip-components=1 || print_error "Extraction failed"
cd "$BUILD"


# 1) types.h: rename 'struct user' tag (conflicts with bionic <sys/user.h>)
sed -i 's/^typedef struct user$/typedef struct user_hashcat/' include/types.h

# 2) Hashcat 8 moved LZMA to a runtime-loaded library; the old LZMA,
#    unrar and affinity patches target code that no longer exists.

# --- Build ---
MAKE_ARCH=
case "$(uname -m)" in aarch64) MAKE_ARCH="IS_AARCH64=1";; esac

print_status "Building hashcat (this may take several minutes)..."
make CC=clang CXX=clang++ LDFLAGS="-liconv" \
     PREFIX="$PREFIX" \
     SHARED_FOLDER="$HASHCAT_DIR/share/hashcat" \
     INSTALL_FOLDER="$HASHCAT_DIR/bin" \
     $MAKE_ARCH \
     -j"$(nproc --all)" hashcat modules || print_error "Build failed"

# --- Install into $PREFIX/opt/hashcat ---
print_status "Installing hashcat..."
rm -rf "$HASHCAT_DIR"
make CC=clang CXX=clang++ LDFLAGS="-liconv" \
     PREFIX="$PREFIX" \
     SHARED_FOLDER="$HASHCAT_DIR/share/hashcat" \
     INSTALL_FOLDER="$HASHCAT_DIR/bin" \
     $MAKE_ARCH \
     install_hashcat install_shared install_kernels install_modules install_tunings install_tools || print_error "Install failed"

[ -x "$HASHCAT_DIR/bin/hashcat" ] || print_error "hashcat binary not found after install"

# --- Launcher ---
cat > "$PREFIX/bin/hashcat" <<EOF
#!/data/data/com.termux/files/usr/bin/bash
LD_LIBRARY_PATH="$PREFIX/opt/vendor/lib:$PREFIX/lib" exec "$HASHCAT_DIR/bin/hashcat" "\$@"
EOF
chmod 755 "$PREFIX/bin/hashcat"

# --- Runtime data directory ---
mkdir -p "$HOME/.local/share/hashcat/"

# --- Cleanup build tree ---
rm -rf "$BUILD" "$TMPDIR/$ARCHIVE"

echo -e "[*] Hashcat ${VERSION} installed successfully."
echo -e "[*] Usage: hashcat -b   (benchmark) / hashcat -I   (list OpenCL devices)"

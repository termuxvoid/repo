#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="3.1"
BUILD_DIR="$TMPDIR/mantra-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/Brosck/mantra/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="379894f36ef04a6b4e57e77112070e23dcc75569d1df98a8f128fe24a8b5e0b1"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o mantra .
install -Dm755 mantra "$PREFIX/bin/mantra"

cd / && rm -rf "$BUILD_DIR"

echo "mantra installed. Run 'mantra'"
exit 0

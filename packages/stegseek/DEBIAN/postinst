#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/RickdeJager/StegSeek/archive/refs/tags/v0.6.tar.gz"
TMP_DIR="$TMPDIR/stegseek-build"
BIN_DIR="$PREFIX/bin"

rm -rf "$TMP_DIR" 2>/dev/null || true
mkdir -p "$TMP_DIR"

curl -fsSL -o "$TMP_DIR/stegseek.tar.gz" "$REPO"
tar xzf "$TMP_DIR/stegseek.tar.gz" -C "$TMP_DIR"
cd "$TMP_DIR/stegseek-0.6"

# C++17 removed std::binary_function/std::unary_function; restore them for
# the legacy steghide-derived headers.
for f in src/SampleValue.h src/WKSConstructionHeuristic.h src/WavPCMSampleValue.h; do
  python - "$f" << 'PYEOF'
import sys
f = sys.argv[1]
s = open(f).read()
marker = "TV_STD_FUNCTOR_SHIM"
if marker in s:
    sys.exit(0)
shim = """

#if __cplusplus > 201402L
#ifndef TV_STD_FUNCTOR_SHIM
#define TV_STD_FUNCTOR_SHIM
namespace std {
template<class Arg, class Result> struct unary_function { typedef Arg argument_type; typedef Result result_type; };
template<class A1, class A2, class Res> struct binary_function { typedef A1 first_argument_type; typedef A2 second_argument_type; typedef Res result_type; };
}
#endif
#endif
"""
s = s.replace("\n#include", shim + "\n#include", 1)
open(f, "w").write(s)
PYEOF
done

cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
cmake --build build

install -Dm755 build/src/stegseek "$BIN_DIR/stegseek"

cd / && rm -rf "$TMP_DIR"

echo "stegseek installed. Run 'stegseek'"
echo "Example: stegseek stego.jpg wordlist.txt"
exit 0
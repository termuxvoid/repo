#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="2.1.7"
BUILD_DIR="$TMPDIR/goshs-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/goshs-labs/goshs/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="7426eb37f6b5e773c1c256c30d76b797c61ee4ba7fd9bd7781f5e3b464af3fdd"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o goshs .
install -Dm755 goshs "$PREFIX/bin/goshs"

cd / && rm -rf "$BUILD_DIR"

echo "goshs installed. Run 'goshs'"
exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="2.1.7"
BUILD_DIR="$TMPDIR/goshs-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/goshs-labs/goshs/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o goshs .
install -Dm755 goshs "$PREFIX/bin/goshs"

cd / && rm -rf "$BUILD_DIR"

echo "goshs installed. Run 'goshs'"
exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
ARCH=$(uname -m)
VERSION="0.1.7"

case "$ARCH" in
    aarch64)
        ARCH_TARGET="arm64"
        LD_SO="ld-linux-aarch64.so.1"
        ;;
    x86_64)
        ARCH_TARGET="amd64"
        LD_SO="ld-linux-x86-64.so.2"
        ;;
    *)
        echo "Unsupported architecture: $ARCH" >&2
        exit 1
        ;;
esac

TARFILE="mimocode-linux-${ARCH_TARGET}.tar.gz"
DOWNLOAD_URL="https://github.com/XiaomiMiMo/MiMo-Code/releases/download/v${VERSION}/${TARFILE}"
SHARE_DIR="$PREFIX/share/mimocode"
BIN_DIR="$PREFIX/bin"
LOADER="$PREFIX/glibc/lib/${LD_SO}"
REAL_BIN="$SHARE_DIR/mimo.real"
LIB_PATH="$PREFIX/glibc/lib"
VERSION_FILE="$SHARE_DIR/VERSION"

# Skip if already installed
if [ -f "$VERSION_FILE" ] && [ "$(cat "$VERSION_FILE")" = "$VERSION" ]; then
    echo "MiMo-Code $VERSION already installed."
    exit 0
fi

mkdir -p "$SHARE_DIR" "$BIN_DIR"

# Download and extract
echo "Downloading MiMo-Code ${VERSION}..."
TMP_TAR="$TMPDIR/${TARFILE}"
curl -fsSL -o "$TMP_TAR" "$DOWNLOAD_URL"

# Backup old binary
[ -f "$REAL_BIN" ] && mv "$REAL_BIN" "${REAL_BIN}.bak"

# Extract
tar -xzf "$TMP_TAR" -C "$SHARE_DIR"
if [ ! -f "$SHARE_DIR/mimo" ]; then
    echo "Error: mimo binary not found after extraction." >&2
    rm -f "$TMP_TAR"
    exit 1
fi
mv "$SHARE_DIR/mimo" "$REAL_BIN"
chmod +x "$REAL_BIN"
rm -f "$TMP_TAR"

# Write version
echo "$VERSION" > "$VERSION_FILE"

# Write C++ wrapper source (internal binary)
cat > "$TMPDIR/mimocode_wrapper.cpp" << WRAPPER_EOF
#include <unistd.h>
#include <cstdlib>
#include <cstdio>
#include <cerrno>
#include <cstring>

constexpr const char* REAL_BIN = "${REAL_BIN}";
constexpr const char* GLIBC_LIB = "${LIB_PATH}";
constexpr const char* GLIBC_LD = "${LOADER}";
constexpr const char* CERT_FILE = "/data/data/com.termux/files/usr/etc/tls/cert.pem";

int main(int argc, char* argv[]) {
    if (argc > 10000) {
        fprintf(stderr, "mimo: too many arguments\n");
        return 1;
    }
    // ponytail: unset LD_LIBRARY_PATH, --library-path provides correct path
    unsetenv("LD_LIBRARY_PATH");
    setenv("GODEBUG", "netdns=cgo", 1);
    setenv("SSL_CERT_FILE", CERT_FILE, 1);

    const char* new_argv[argc + 4];
    new_argv[0] = GLIBC_LD;
    new_argv[1] = "--library-path";
    new_argv[2] = GLIBC_LIB;
    new_argv[3] = REAL_BIN;
    for (int i = 1; i < argc; ++i)
        new_argv[i + 3] = argv[i];
    new_argv[argc + 3] = nullptr;

    execv(GLIBC_LD, const_cast<char* const*>(new_argv));
    int saved = errno;
    fprintf(stderr, "mimo: execv %s failed: %s\\n", GLIBC_LD, strerror(saved));
    fprintf(stderr, "Hint: is glibc installed? Run 'pkg install glibc'\\n");
    return 126;
}
WRAPPER_EOF

# Compile C++ wrapper as internal binary
clang++ -O2 -o "$SHARE_DIR/mimo.bin" "$TMPDIR/mimocode_wrapper.cpp"
chmod +x "$SHARE_DIR/mimo.bin"
rm -f "$TMPDIR/mimocode_wrapper.cpp"

# Create enhanced shell wrapper with banner
cat > "$BIN_DIR/mimo" << 'BANNER_EOF'
#!/data/data/com.termux/files/usr/bin/bash
# MiMo-Code with enhanced TUI banner
# Credits: @ykrishhh for wrapper improvements

VERSION_FILE="/data/data/com.termux/files/usr/share/mimocode/VERSION"
REAL_BIN="/data/data/com.termux/files/usr/share/mimocode/mimo.bin"

# Show banner only for interactive TUI (no args or --help)
if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    if [ -t 1 ]; then
        # Terminal detected - show banner
        echo ""
        echo -e "\e[1;35m╔══════════════════════════════════════════════════════════╗\e[0m"
        echo -e "\e[1;35m║\e[0m\e[1;37m                    ███╗   ███╗██╗ ██████╗\e[0m\e[1;35m                 ║\e[0m"
        echo -e "\e[1;35m║\e[0m\e[1;37m                    ████╗ ████║██║██╔════╝\e[0m\e[1;35m                 ║\e[0m"
        echo -e "\e[1;35m║\e[0m\e[1;37m                    ██╔████╔██║██║██║     \e[0m\e[1;35m                 ║\e[0m"
        echo -e "\e[1;35m║\e[0m\e[1;37m                    ██║╚██╔╝██║██║██║     \e[0m\e[1;35m                 ║\e[0m"
        echo -e "\e[1;35m║\e[0m\e[1;37m                    ██║ ╚═╝ ██║██║╚██████╗\e[0m\e[1;35m                 ║\e[0m"
        echo -e "\e[1;35m║\e[0m\e[1;37m                    ╚═╝     ╚═╝╚═╝ ╚═════╝\e[0m\e[1;35m                 ║\e[0m"
        echo -e "\e[1;35m║\e[0m                                                                \e[1;35m║\e[0m"
        echo -e "\e[1;35m║\e[0m\e[1;33m  🧠 MiMo AI - Intelligent Code Assistant\e[0m\e[1;35m                      ║\e[0m"
        echo -e "\e[1;35m║\e[0m\e[0;37m  Version: $(cat "$VERSION_FILE" 2>/dev/null || echo "unknown") | Platform: Termux/$(uname -m)\e[0m\e[1;35m       ║\e[0m"
        echo -e "\e[1;35m║\e[0m\e[0;37m  Enhanced wrapper by @ykrishhh | TermuxVoid Repo\e[0m\e[1;35m            ║\e[0m"
        echo -e "\e[1;35m╚══════════════════════════════════════════════════════════╝\e[0m"
        echo ""
    fi
fi

exec "$REAL_BIN" "$@"
BANNER_EOF
chmod +x "$BIN_DIR/mimo"

echo "MiMo-Code $VERSION installed successfully."
echo "Run 'mimo' to start."
exit 0
#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/Ekultek/WhatBreach.git"
INSTALL_DIR="$PREFIX/share/whatbreach"
LAUNCHER="$PREFIX/bin/whatbreach"

rm -rf "$INSTALL_DIR" 2>/dev/null || true

git clone --depth 1 "$REPO" "$INSTALL_DIR"

cd "$INSTALL_DIR"
pip install -r requirements.txt

cat > "$LAUNCHER" << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash
cd "$PREFIX/share/whatbreach"
exec python whatbreach.py "$@"
EOF

chmod +x "$LAUNCHER"

echo "WhatBreach installed successfully."
echo "Run 'whatbreach' to start."
exit 0

#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="2.2.4"
BUILD_DIR="$TMPDIR/gau-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/lc/gau/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="537abafca9065a7ed5d93aa7722d85da0815abf6b08c2d1494483171558ce3f7"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o gau ./cmd/gau
install -Dm755 gau "$PREFIX/bin/gau"

cd / && rm -rf "$BUILD_DIR"

echo "gau installed. Run 'gau'"
exit 0

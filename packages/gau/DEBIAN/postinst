#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="2.2.4"
BUILD_DIR="$TMPDIR/gau-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/lc/gau/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o gau ./cmd/gau
install -Dm755 gau "$PREFIX/bin/gau"

cd / && rm -rf "$BUILD_DIR"

echo "gau installed. Run 'gau'"
exit 0

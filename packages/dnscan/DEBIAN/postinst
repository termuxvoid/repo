#!/data/data/com.termux/files/usr/bin/bash
set -e

REPO="https://github.com/rbsec/dnscan.git"
DEST="$PREFIX/share/dnscan"
LAUNCHER="$PREFIX/bin/dnscan"

pip install dnspython netaddr packaging

rm -rf "$DEST" 2>/dev/null || true
git clone --depth 1 "$REPO" "$DEST"

python - "$DEST/dnscan.py" << 'PYEOF'
import sys
f = sys.argv[1]
s = open(f).read()
patched = s.find("Resolver(configure=False)") != -1
if not patched:
    old = "    resolver = dns.resolver.Resolver()\n"
    new = "    resolver = dns.resolver.Resolver(configure=False)\n"
    assert old in s
    s = s.replace(old, new, 1)
old2 = """    elif args.resolvers:
        resolver.nameservers = args.resolvers.split(",")
"""
new2 = old2 + """    else:
        resolver.nameservers = ["8.8.8.8", "1.1.1.1"]
"""
if old2 in s:
    s = s.replace(old2, new2, 1)
open(f, "w").write(s)
print("termux resolv.conf patch applied" if not patched else "already patched")
PYEOF

cat > "$LAUNCHER" <<'EOF'
#!/data/data/com.termux/files/usr/bin/bash
cd "$PREFIX/share/dnscan"
exec python dnscan.py "$@"
EOF
chmod +x "$LAUNCHER"

echo "dnscan installed. Run 'dnscan'"
echo "Example: dnscan -d example.com -R 8.8.8.8"
exit 0
#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="20130616"
URL="https://darkside.com.au/snow/snow-${VERSION}.tar.gz"
TMP_DIR="$TMPDIR/snow-build"

rm -rf "$TMP_DIR" 2>/dev/null || true
mkdir -p "$TMP_DIR"
cd "$TMP_DIR"

curl -fsSL -o snow.tar.gz "$URL"
SHA256="c0b71aa74ed628d121f81b1cd4ae07c2842c41cfbdf639b50291fc527c213865"
if ! printf '%s  %s\n' "$SHA256" "snow.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: snow.tar.gz" >&2
    rm -f "snow.tar.gz"
    exit 1
fi
tar -xzf snow.tar.gz
cd "snow-${VERSION}"

make

install -Dm755 snow "$PREFIX/bin/snow"

cd / && rm -rf "$TMP_DIR"

echo "snow installed. Run 'snow'"
echo "Example: snow -C -m 'secret' notes.txt out.txt"
exit 0
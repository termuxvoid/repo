#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="3.5.6"
BUILD_DIR="$TMPDIR/afrog-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/zan8in/afrog/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="5b72cc0fb075d0c7f7849672c7431b744a6146451224596abd89fcb6f9a34ed6"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go mod vendor || { go mod tidy && go mod vendor; }

# dm driver overflows uint32 on 32-bit builds; upstream fix pending
PATCH_FILE="vendor/gitee.com/chunanyong/dm/zq.go"
if [ -f "$PATCH_FILE" ]; then
    sed -i 's/Dm_build_704 && len(dataBytes) < 0xffffffff &&/Dm_build_704 \&\& uint32(len(dataBytes)) < uint32(0xffffffff) \&\&/' "$PATCH_FILE"
fi

go build -trimpath -ldflags "-w -s" -o afrog ./cmd/afrog
install -Dm755 afrog "$PREFIX/bin/afrog"

cd / && rm -rf "$BUILD_DIR"

echo "afrog installed. Run 'afrog'"
exit 0

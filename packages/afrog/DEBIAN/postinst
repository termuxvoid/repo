#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v3.5.8"
BUILD_DIR="$TMPDIR/afrog-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/zan8in/afrog/archive/refs/tags/v3.5.8.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o afrog ./cmd/afrog
install -Dm755 afrog "$PREFIX/bin/afrog"

cd / && rm -rf "$BUILD_DIR"

echo "afrog installed. Run 'afrog'"
exit 0

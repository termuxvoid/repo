#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="3.5.11"
BUILD_DIR="$TMPDIR/afrog-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/zan8in/afrog/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="da9a73b3fd828f0f937e7cf911c4655407cf77d0310c89db7a6bbf4a43038ba0"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go mod vendor || { go mod tidy && go mod vendor; }

# dm driver overflows uint32 on 32-bit builds; upstream fix pending
PATCH_FILE="vendor/gitee.com/chunanyong/dm/zq.go"
if [ ! -f "$PATCH_FILE" ]; then
    echo "Error: afrog dm patch target missing: $PATCH_FILE" >&2
    exit 1
fi
if grep -Fq 'Dm_build_704 && len(dataBytes) < 0xffffffff &&' "$PATCH_FILE"; then
    sed -i 's/Dm_build_704 && len(dataBytes) < 0xffffffff &&/Dm_build_704 \&\& uint32(len(dataBytes)) < uint32(0xffffffff) \&\&/' "$PATCH_FILE"
elif ! grep -Fq 'Dm_build_704 && uint32(len(dataBytes)) < uint32(0xffffffff) &&' "$PATCH_FILE"; then
    echo "Error: afrog dm patch no longer applies; review upstream changes." >&2
    exit 1
fi

# excelize compares int sizes against math.MaxUint32, which fails on 32-bit builds
EXCELIZE_FILE="vendor/github.com/xuri/excelize/v2/file.go"
if [ ! -f "$EXCELIZE_FILE" ]; then
    echo "Error: afrog excelize patch target missing: $EXCELIZE_FILE" >&2
    exit 1
fi
if grep -Fq '; n > math.MaxUint32' "$EXCELIZE_FILE"; then
    sed -i 's/; n > math.MaxUint32/; uint64(n) > math.MaxUint32/g' "$EXCELIZE_FILE"
elif ! grep -Fq '; uint64(n) > math.MaxUint32' "$EXCELIZE_FILE"; then
    echo "Error: afrog excelize patch no longer applies; review upstream changes." >&2
    exit 1
fi

go build -trimpath -ldflags "-w -s" -o afrog ./cmd/afrog
install -Dm755 afrog "$PREFIX/bin/afrog"

cd / && rm -rf "$BUILD_DIR"

echo "afrog installed. Run 'afrog'"
exit 0

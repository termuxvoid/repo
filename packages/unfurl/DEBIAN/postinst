#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="0.4.3"
BUILD_DIR="$TMPDIR/unfurl-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/tomnomnom/unfurl/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="124e7c476af31745838322422771c664280d192aa56b586e431fc0b9b422ea50"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o unfurl .
install -Dm755 unfurl "$PREFIX/bin/unfurl"

cd / && rm -rf "$BUILD_DIR"

echo "unfurl installed. Run 'unfurl'"
exit 0

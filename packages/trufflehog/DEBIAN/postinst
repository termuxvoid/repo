#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v3.99.4"
BUILD_DIR="$TMPDIR/trufflehog-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/trufflesecurity/trufflehog/archive/refs/tags/v3.99.4.tar.gz"
SHA256="2003b23e35751bed50bdd8fbef6ee9333c42145d489d97ecd7f14227f1de8b44"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -o trufflehog .
install -Dm755 trufflehog "$PREFIX/bin/trufflehog"

cd / && rm -rf "$BUILD_DIR"

echo "trufflehog installed. Run 'trufflehog'"
exit 0

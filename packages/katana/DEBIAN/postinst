#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="1.8.0"
BUILD_DIR="$TMPDIR/katana-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/projectdiscovery/katana/archive/refs/tags/v${VERSION}.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o katana ./cmd/katana
install -Dm755 katana "$PREFIX/bin/katana"

cd / && rm -rf "$BUILD_DIR"

echo "katana installed. Run 'katana'"
exit 0

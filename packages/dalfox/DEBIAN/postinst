#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="3.2.4"
BUILD_DIR="$TMPDIR/dalfox-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

SHA256="d86cae222a4db6c8a335013c980d0c6d672b3abee8cfb44da6ce1b489e4d3a9b"
curl -L -o "dalfox-${VERSION}.tar.gz" \
  "https://github.com/hahwul/dalfox/archive/refs/tags/v${VERSION}.tar.gz"
if ! printf '%s  %s\n' "$SHA256" "dalfox-${VERSION}.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: dalfox-${VERSION}.tar.gz" >&2
    rm -f "dalfox-${VERSION}.tar.gz"
    exit 1
fi

tar -xzf "dalfox-${VERSION}.tar.gz"
cd "dalfox-${VERSION}"

cargo build --release --locked

install -Dm755 target/release/dalfox "$PREFIX/bin/dalfox"

cd /
rm -rf "$BUILD_DIR"

exit 0

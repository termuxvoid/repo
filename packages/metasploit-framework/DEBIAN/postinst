#!/data/data/com.termux/files/usr/bin/bash
set -e

MSFPATH="$PREFIX/opt/metasploit-framework"
TAG="6.4.142"
ZIP_URL="https://github.com/rapid7/metasploit-framework/archive/refs/tags/${TAG}.zip"

[ -d "$MSFPATH" ] && rm -rf "$MSFPATH"
mkdir -p $PREFIX/opt

wget -q "$ZIP_URL" -O "$TMPDIR/msf.zip"
unzip -q "$TMPDIR/msf.zip" -d "$TMPDIR"
mv "$TMPDIR/metasploit-framework-${TAG}" "$MSFPATH"
rm -f "$TMPDIR/msf.zip"

cd "$MSFPATH"

gem install bundler

# ruby 4.0 ships date 3.5.1 as a default gem; metasploit gemspec pins date
# 3.4.1 ("Temporarily pinned until 3.5 can be tested"). Relax the pin so
# bundler can use the default date and avoid the activation conflict.
sed -i "s/add_runtime_dependency 'date', '3.4.1'/add_runtime_dependency 'date', '>= 3.4.1'/" metasploit-framework.gemspec

# Extract exact versions from Gemfile.lock
ACTIONVIEW_VER=$(grep "actionview (" Gemfile.lock | awk '{print $2}' | tr -d '()')
NET_VER=$(grep "network_interface (" Gemfile.lock | awk '{print $2}' | tr -d '()')

# Install network_interface with workaround
gem install network_interface -v "$NET_VER" -- --with-cflags="-Wno-error=implicit-function-declaration" 2>/dev/null || true

# Remove lock file and add actionview with correct version using single equals
rm -f Gemfile.lock
bundle add actionview --version "$ACTIONVIEW_VER"

bundle config set documentation false
# Build sqlite3 against Termux's system sqlite; the default vendored
# (mini_portile2) build path has no resolver on ruby 4.0 and fails.
bundle config set build.sqlite3 "--enable-system-libraries"
bundle install -j$(nproc --all)
bundle update --bundler

# Termux has no /usr/bin/env; point the launcher shebangs at Termux's env and
# enable rubygems explicitly (termux ruby does not auto-load rubygems) so gems
# that are required directly (rex/*, getoptlong, ...) resolve properly.
find "$MSFPATH" -maxdepth 1 -type f -executable -not -name "*.rb" -not -name "*.sh" -not -name "*.ru" -not -name "*.pl" | while read file; do
    sed -i "1s|^#!/usr/bin/env ruby$|#!$PREFIX/bin/env ruby|" "$file"
    grep -qE "^require ['\"]rubygems" "$file" || sed -i "1a require 'rubygems' unless defined?(Gem)" "$file"
done

# msfdb requires rex/* before its bundler boot, which activates ruby's default
# openssl (4.0.2) ahead of the bundled 3.3.3 and breaks bundler. Boot the bundle
# first, exactly like msfconsole does.
if [ -f "$MSFPATH/msfdb" ] && ! grep -q "config/boot" "$MSFPATH/msfdb"; then
    sed -i "2a require File.expand_path('config/boot', __dir__)" "$MSFPATH/msfdb"
fi

# Create bin wrappers for executable root scripts. The upstream scripts carry a
# /usr/bin/env shebang (missing on Termux), so run them via ruby with the
# framework Gemfile exported so bundler/setup finds it regardless of CWD.
find "$MSFPATH" -maxdepth 1 -type f -executable -not -name "*.rb" -not -name "*.sh" -not -name "*.ru" -not -name "*.pl" | while read file; do
    binname=$(basename "$file")
    cat > "$PREFIX/bin/$binname" <<EOF
#!/data/data/com.termux/files/usr/bin/env bash
export BUNDLE_GEMFILE="$MSFPATH/Gemfile"
exec ruby "$file" "\$@"
EOF
    chmod +x "$PREFIX/bin/$binname"
done

echo "Metasploit-Framework $TAG installed successfully"
echo "Run 'msfconsole' or 'msfvenom'"
exit 0

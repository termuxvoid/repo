#!/data/data/com.termux/files/usr/bin/bash
set -e

TAG="v1.7.3"
TMP_DIR="$TMPDIR/sliver-build"
BIN_DIR="$PREFIX/bin"
ARCHIVE_URL="https://github.com/BishopFox/sliver/archive/refs/tags/${TAG}.tar.gz"

LDFLAGS="-s -w -X github.com/bishopfox/sliver/client/command/update.SliverPublicKey=RWTZPg959v3b7tLG7VzKHRB1/QT+d3c71Uzetfa44qAoX5rH7mGoQTTR -X github.com/bishopfox/sliver/client/assets.DefaultArmoryPublicKey=RWSBpxpRWDrD7Fe+VvRE3c2VEDC2NK80rlNCj+BX0gz44Xw07r6KQD9L -X github.com/bishopfox/sliver/client/assets.DefaultArmoryRepoURL=https://api.github.com/repos/sliverarmory/armory/releases -X github.com/bishopfox/sliver/server/version.Version=${TAG} -X github.com/bishopfox/sliver/server/version.GitCommit=3bbaf805104dcc4a75414ee0084e8de50702cad4 -X github.com/bishopfox/sliver/client/version.Version=${TAG} -X github.com/bishopfox/sliver/client/version.GitCommit=3bbaf805104dcc4a75414ee0084e8de50702cad4"

rm -rf "$TMP_DIR" 2>/dev/null || true
mkdir -p "$TMP_DIR"
curl -fsSL "$ARCHIVE_URL" -o "$TMP_DIR/sliver.tar.gz"
tar -xzf "$TMP_DIR/sliver.tar.gz" -C "$TMP_DIR" --strip-components=1
cd "$TMP_DIR"

cat > "$TMP_DIR/patch_assets.py" << 'PYEOF'
import os, subprocess
base = os.environ["SLIVER_DIR"]

def rewrite_slice(path, marker, new_block):
    with open(path) as f: lines = f.read().split("\n")
    out, i, done = [], 0, False
    while i < len(lines):
        if lines[i].strip() == marker and not done:
            out.append(lines[i]); out.extend(new_block.split("\n")); i += 1
            while i < len(lines) and lines[i].strip() != "}": i += 1
            i += 1; done = True
        else: out.append(lines[i]); i += 1
    open(path, "w").write("\n".join(out))

rewrite_slice(base + "/util/assets/go.go", "platforms := []goPlatform{", '''
\t\t{
\t\t\tos:         "linux",
\t\t\tarch:       "amd64",
\t\t\tarchiveExt: "tar.gz",
\t\t\ttoolRemoves: []string{
\t\t\t\t"pkg/tool/linux_amd64/doc",
\t\t\t\t"pkg/tool/linux_amd64/tour",
\t\t\t\t"pkg/tool/linux_amd64/test2json",
\t\t\t},
\t\t},
\t\t{
\t\t\tos:         "linux",
\t\t\tarch:       "arm64",
\t\t\tarchiveExt: "tar.gz",
\t\t\tincludeSrc: true,
\t\t\ttoolRemoves: []string{
\t\t\t\t"pkg/tool/linux_arm64/doc",
\t\t\t\t"pkg/tool/linux_arm64/tour",
\t\t\t\t"pkg/tool/linux_arm64/test2json",
\t\t\t},
\t\t},
\t}''')

rewrite_slice(base + "/util/assets/garble.go", "platforms := []garblePlatform{", '''
\t\t{
\t\t\tos:       "linux",
\t\t\tarch:     "amd64",
\t\t\tfilename: "garble",
\t\t\turl:      fmt.Sprintf("https://github.com/moloch--/garble/releases/download/v%s/garble_linux-amd64", garbleVersion),
\t\t},
\t\t{
\t\t\tos:       "linux",
\t\t\tarch:     "arm64",
\t\t\tfilename: "garble",
\t\t\turl:      fmt.Sprintf("https://github.com/moloch--/garble/releases/download/v%s/garble_linux-arm64", garbleVersion),
\t\t},
\t}''')

subprocess.run(["sed", "-i", "/remoteName:/d", base + "/util/assets/zig.go"], check=True)
for f in ["server/assets/assets_darwin_amd64.go", "server/assets/assets_darwin_arm64.go",
          "server/assets/assets_windows_amd64.go", "server/assets/assets_windows_arm64.go"]:
    if os.path.exists(base + "/" + f): os.remove(base + "/" + f)
PYEOF
SLIVER_DIR="$TMP_DIR" python3 "$TMP_DIR/patch_assets.py"

go run -mod=vendor ./util/cmd/assets
go build -mod=vendor -trimpath -tags go_sqlite,server -ldflags "$LDFLAGS" -p $(nproc) -o sliver-server ./server
CGO_ENABLED=0 go build -mod=vendor -trimpath -tags go_sqlite,client -ldflags "$LDFLAGS" -p $(nproc) -o sliver-client ./client

install -Dm755 sliver-server "$BIN_DIR/sliver-server"
install -Dm755 sliver-client "$BIN_DIR/sliver-client"

cd / && rm -rf "$TMP_DIR"
echo "sliver-c2 installed. Run 'sliver-server' or 'sliver-client'"
exit 0

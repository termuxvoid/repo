#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="2.6.1"
BUILD_DIR="$TMPDIR/naabu-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/projectdiscovery/naabu/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="2bf03345fd3d640624a07c6e255470a342d1e6a7c071d748c57eeb0d40955a8c"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o naabu ./cmd/naabu
install -Dm755 naabu "$PREFIX/bin/naabu"

cd / && rm -rf "$BUILD_DIR"

echo "naabu installed. Run 'naabu'"
exit 0

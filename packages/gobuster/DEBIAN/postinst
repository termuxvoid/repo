#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="3.8.2"
BUILD_DIR="$TMPDIR/gobuster-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/OJ/gobuster/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="6919232eafbd0c4bbc9664d7f434b6a8d82133aa09f1400341ef6985ceff208a"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o gobuster .
install -Dm755 gobuster "$PREFIX/bin/gobuster"

cd / && rm -rf "$BUILD_DIR"

echo "gobuster installed. Run 'gobuster'"
exit 0

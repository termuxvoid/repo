#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="2.0.2"
BUILD_DIR="$TMPDIR/vulnx-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/projectdiscovery/vulnx/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="d3954dbcbee35fc7ff5417d3314949d7f7e1cf4939082a153515ce58b51ab7a6"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o vulnx ./cmd/vulnx
install -Dm755 vulnx "$PREFIX/bin/vulnx"

cd / && rm -rf "$BUILD_DIR"

echo "vulnx installed. Run 'vulnx'"
exit 0

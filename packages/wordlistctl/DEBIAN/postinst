#!/data/data/com.termux/files/usr/bin/bash
set -e

python -m pip install --extra-index-url https://termux-user-repository.github.io/pypi/ --prefer-binary --quiet termcolor requests || pip install termcolor requests

mkdir -p $PREFIX/share/wordlistctl
cd $PREFIX/share/wordlistctl

if [ ! -f wordlistctl.py ]; then
    mkdir -p "$TMPDIR/wordlistctl-download"
    curl -fsSL -o "$TMPDIR/wordlistctl-download/wordlistctl.py" \
        https://raw.githubusercontent.com/BlackArch/wordlistctl/v0.9.4/wordlistctl.py
    SHA256="4434b5e637a3a9ae4df8a08b7d14c67055ec5bf9267d45a95f3340456c71e793"
    if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/wordlistctl-download/wordlistctl.py" | sha256sum -c - >/dev/null; then
        echo "checksum mismatch: $TMPDIR/wordlistctl-download/wordlistctl.py" >&2
        rm -f "$TMPDIR/wordlistctl-download/wordlistctl.py"
        exit 1
    fi
    curl -fsSL -o "$TMPDIR/wordlistctl-download/repo.json" \
        https://raw.githubusercontent.com/BlackArch/wordlistctl/v0.9.4/repo.json
    SHA256="8a7ffd0de2633d04161c70d858949a00f77680667905f673644c52bed676bcf3"
    if ! printf '%s  %s\n' "$SHA256" "$TMPDIR/wordlistctl-download/repo.json" | sha256sum -c - >/dev/null; then
        echo "checksum mismatch: $TMPDIR/wordlistctl-download/repo.json" >&2
        rm -f "$TMPDIR/wordlistctl-download/repo.json"
        exit 1
    fi
    mv "$TMPDIR/wordlistctl-download/wordlistctl.py" wordlistctl.py
    mv "$TMPDIR/wordlistctl-download/repo.json" repo.json
    rm -rf "$TMPDIR/wordlistctl-download"
fi

python - << 'PYEOF'
import pathlib, os
f = pathlib.Path(os.environ["PREFIX"]) / "share/wordlistctl/wordlistctl.py"
s = f.read_text()
old = 'WORDLIST_PATH: str = "/usr/share/wordlists"'
new = 'WORDLIST_PATH: str = os.environ.get("PREFIX", "") + "/share/wordlists"'
if old in s:
    f.write_text(s.replace(old, new, 1))
    print("termux wordlist path patch applied")
else:
    print("wordlist path already patched")
PYEOF

cat > $PREFIX/bin/wordlistctl << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash
cd "$PREFIX/share/wordlistctl"
exec python wordlistctl.py "$@"
EOF
chmod +x $PREFIX/bin/wordlistctl

echo "wordlistctl installed successfully."
echo ""
echo "Usage examples:"
echo "  wordlistctl search rockyou"
echo "  wordlistctl list -g web"
echo "  wordlistctl fetch -l rockyou.txt"

exit 0
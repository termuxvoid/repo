#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v1.12.1"
BUILD_DIR="$TMPDIR/chisel-build"

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/jpillora/chisel/archive/refs/tags/v1.12.1.tar.gz"
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s -X github.com/jpillora/chisel/share.BuildVersion=v1.12.1" -o chisel .
install -Dm755 chisel "$PREFIX/bin/chisel"

cd / && rm -rf "$BUILD_DIR"

echo "chisel installed. Run 'chisel'"
exit 0

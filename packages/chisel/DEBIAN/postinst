#!/data/data/com.termux/files/usr/bin/bash
set -e

mkdir -p $PREFIX/share/chisel
cd $PREFIX/share/chisel
if [ ! -d chisel ]; then
    git clone --filter=blob:none --no-checkout https://github.com/jpillora/chisel.git chisel
fi
cd chisel
git checkout -q 3c00f04ca15472cf6e308227ec24c88c8f5d4ab3
go build -trimpath -ldflags "-w -s" -o $PREFIX/bin/chisel ./

echo "chisel installed successfully."
echo ""
echo "Usage examples:"
echo "  chisel server --reverse --port 8080"
echo "  chisel client SERVER_IP:8080 R:8888:localhost:80"
echo "  chisel client SERVER_IP:8080 9999:localhost:3306"

exit 0
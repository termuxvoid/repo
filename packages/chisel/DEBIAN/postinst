#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="v1.13.0"
BUILD_DIR="$TMPDIR/chisel-build"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

curl -fsSL -o src.tar.gz "https://github.com/jpillora/chisel/archive/refs/tags/v1.13.0.tar.gz"
SHA256="beae93bb474c814f4f076324b3d1a0a5a20e449025004072cdbd66aa5f42c461"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s -X github.com/jpillora/chisel/share.BuildVersion=v1.13.0" -o chisel .
install -Dm755 chisel "$PREFIX/bin/chisel"

cd / && rm -rf "$BUILD_DIR"

echo "chisel installed. Run 'chisel'"
exit 0

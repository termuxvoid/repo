#!/data/data/com.termux/files/usr/bin/bash
set -e

VERSION="2.2"
DEST="$PREFIX/share/stowaway"

rm -rf "$DEST"
mkdir -p "$DEST"
cd "$DEST"

curl -fsSL -o src.tar.gz "https://github.com/ph4ntonn/Stowaway/archive/refs/tags/v${VERSION}.tar.gz"
SHA256="265fbe45778cf694ee3a2c3e0c17f2d824f580adad6d3e61d67eb9250ac72858"
if ! printf '%s  %s\n' "$SHA256" "src.tar.gz" | sha256sum -c - >/dev/null; then
    echo "checksum mismatch: src.tar.gz" >&2
    rm -f "src.tar.gz"
    exit 1
fi
tar -xzf src.tar.gz --strip-components=1

go build -trimpath -ldflags "-w -s" -o "$PREFIX/bin/stowaway-admin" admin/admin.go
go build -trimpath -ldflags "-w -s" -o "$PREFIX/bin/stowaway-agent" agent/agent.go
cd /

rm -rf "$DEST"

echo "stowaway installed. Binaries: stowaway-admin, stowaway-agent"
echo "To build a chain: run 'stowaway-admin -l <port> -s <secret>' on this host,"
echo "then on other hosts: 'stowaway-agent -c <ip>:<port> -s <secret>'"
exit 0
